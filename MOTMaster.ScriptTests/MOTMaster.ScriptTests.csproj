<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net462, not net461: xunit.runner.visualstudio needs >= net462 for its VS Test
         Explorer integration. net462 can still reference MOTMaster.exe/DAQ.dll's net461
         (v4.6.1) binaries directly - .NET Framework references bind fine across nearby
         versions in the same family, and the v4.6.2 targeting pack is already on this
         machine (confirmed: C:\Program Files (x86)\Reference Assemblies\Microsoft\
         Framework\.NETFramework\v4.6.2). -->
    <TargetFramework>net462</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <!--
    Deliberately NOT ProjectReference'ing MOTMaster.csproj/DAQ.csproj: those are legacy
    non-SDK projects with no Debug/Release configuration (only per-experiment ones like
    CaF), so a plain ProjectReference from this SDK-style project would try to build them
    under a configuration that doesn't exist for them (the same MSB4126 shape
    MoleculeMOTMasterScripts.csproj hits - see the motmaster-controller skill).

    Instead this references their built *output* directly, exactly like MOTMaster's own
    runtime script compiler does (Controller.compileFromFile) - see
    .claude/skills/motmaster-controller/references/architecture.md. That means these DLLs
    must already be built under the CaF configuration before `dotnet test` will pass -
    run the msbuild command in that skill's SKILL.md first (or whenever these tests report
    "referenced assembly not found").
  -->
  <ItemGroup>
    <Reference Include="MOTMaster">
      <HintPath>..\MOTMaster\bin\CaF\MOTMaster.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DAQ">
      <HintPath>..\DAQ\bin\CaF\DAQ.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SpectrumDDS" Condition="Exists('..\SpectrumDDS\bin\CaF\SpectrumDDS.dll')">
      <HintPath>..\SpectrumDDS\bin\CaF\SpectrumDDS.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
